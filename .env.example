# =============================================================================
# DLS TOURNAMENT PLATFORM — ENVIRONMENT VARIABLES
# =============================================================================
# 1. Copy this file to `.env.local` for local development:
#       cp .env.example .env.local
# 2. Fill in every value below (instructions are next to each variable).
# 3. For production, add the SAME variables in the Vercel dashboard:
#       Vercel Project -> Settings -> Environment Variables
#    (Add them BEFORE the first deploy, then redeploy.)
#
# NOTES
# - Variables starting with NEXT_PUBLIC_ are sent to the browser. Never put a
#   secret key in a NEXT_PUBLIC_ variable.
# - Never commit your real `.env.local` file (it is already in .gitignore).
# =============================================================================


# -----------------------------------------------------------------------------
# SUPABASE  (https://supabase.com — free tier)
# -----------------------------------------------------------------------------
# Where to find all three values:
#   Supabase Dashboard -> your project -> Settings -> API
#   ("Project URL", "anon public" key, "service_role" key)

# Your project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url

# Public "anon" key. Safe to expose: Row Level Security limits it to reading
# public tables and inserting registrations.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# SECRET server-only key. Bypasses Row Level Security — it is only ever used
# inside /app/api routes and server components. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key


# -----------------------------------------------------------------------------
# PAYSTACK  (https://dashboard.paystack.com — free to create an account)
# -----------------------------------------------------------------------------
# Where to find them:
#   Paystack Dashboard -> Settings -> API Keys & Webhooks
# Use the TEST keys while building, then swap in the LIVE keys before launch.

# Public key. Starts with pk_test_ (test mode) or pk_live_ (live mode).
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=your_paystack_public_key

# Secret key. Starts with sk_test_ or sk_live_. SERVER ONLY — never expose it.
PAYSTACK_SECRET_KEY=your_paystack_secret_key


# -----------------------------------------------------------------------------
# TOURNAMENT MONEY SETTINGS
# -----------------------------------------------------------------------------
# Entry fee in PESEWAS (Paystack's smallest currency unit).
# GH₵10 = 1000 pesewas. The landing page prize pool is calculated from this.
NEXT_PUBLIC_TOURNAMENT_ENTRY_FEE=1000

# The organizer's cut of the total pot, in percent. 15 means 15%.
# Remaining prize pool is split 70% winner / 30% runner-up.
NEXT_PUBLIC_ORGANIZER_CUT_PERCENT=15


# -----------------------------------------------------------------------------
# ADMIN
# -----------------------------------------------------------------------------
# The password for the organizer dashboard at /admin (Module 4) — you type it
# into the login form once per browser tab. The same secret also authenticates
# direct API calls via the `x-admin-secret` header. Make it long and random,
# e.g. the output of: openssl rand -hex 24
#
# Example API call:
#   curl -X POST https://your-app.vercel.app/api/admin/draw-groups \
#     -H "x-admin-secret: YOUR_ADMIN_SECRET" \
#     -H "Content-Type: application/json" \
#     -d '{"tournament_id":"the-tournament-uuid"}'
ADMIN_SECRET=your_admin_secret_key


# -----------------------------------------------------------------------------
# WHATSAPP CONTACTS
# -----------------------------------------------------------------------------
# Your WhatsApp number in international format, digits only (no +, no spaces).
# A Ghanaian number 024 123 4567 becomes 233241234567.
NEXT_PUBLIC_WHATSAPP_CONTACT=233000000000

# Invite link for the players' WhatsApp group, shown on the success page.
# WhatsApp group -> Group info -> Invite via link -> Copy link
NEXT_PUBLIC_WHATSAPP_GROUP_INVITE_URL=https://chat.whatsapp.com/your-invite-code


# -----------------------------------------------------------------------------
# SITE URL
# -----------------------------------------------------------------------------
# The public URL of this deployment. Used for the Paystack callback and the
# "challenge a friend" share link.
# Local development: http://localhost:3000
# Production:        https://your-app.vercel.app  (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
